# Crystal Edge Digital — environment variables
#
# Copy to `.env` for local dev, and set the same keys in Vercel's
# Production/Preview env for stage/prod.

# --- Contact form delivery (app/api/contact/route.ts) ----------------------
# Requires a verified sending domain in Resend. See lib/resend.ts for how
# these are read; the API route 500s with a clear error if any are missing.

# Resend API key, scoped to this site (Resend dashboard → API Keys).
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, e.g.
# "Crystal Edge Digital <hello@send.crystal-edge-digital.com>".
CONTACT_FROM_EMAIL=

# Team inbox that receives work-request notifications.
CONTACT_TO_EMAIL=info@crystal-edge-digital.com
